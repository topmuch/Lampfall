# ─── Configuration Lampfall ─────────────────────────────────────────────────
# Copier ce fichier en .env puis ajuster si besoin :  cp .env.example .env

# Base de données SQLite (chemin relatif au dossier prisma/)
# Le fichier db/custom.db est créé automatiquement par : bun run db:push
DATABASE_URL=file:../db/custom.db
