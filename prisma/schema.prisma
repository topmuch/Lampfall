generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Clients ────────────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  type      String   @default("PARTICULIER") // PARTICULIER | ENTREPRISE
  notes     String?
  createdAt DateTime @default(now())

  invoices Invoice[]
  orders   Order[]
}

// ─── Catégories (dynamiques) ────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  code      String   @unique // SANITAIRE, PLOMBERIE, …
  label     String // Affichage : Sanitaire, Plomberie, …
  createdAt DateTime @default(now())
}

// ─── Produits (catalogue) ───────────────────────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  name          String
  reference     String?
  category      String // code catégorie (voir Category)
  image         String? // data-URL de l'image du produit
  purchasePrice Float    @default(0)
  salePrice     Float    @default(0)
  stock         Int      @default(0)
  unit          String   @default("pièce")
  minStock      Int      @default(0)
  createdAt     DateTime @default(now())
}

// ─── Factures (vente + proforma) ────────────────────────────────────────────

model Invoice {
  id             String    @id @default(cuid())
  number         String    @unique
  type           String    @default("VENTE") // VENTE | PROFORMA
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName     String    @default("")
  clientPhone    String?
  clientAddress  String?
  date           DateTime  @default(now())
  dueDate        DateTime?
  deliveryStatus String    @default("NON_LIVRE") // LIVRE | NON_LIVRE
  paymentStatus  String    @default("NON_PAYE") // PAYE | PARTIEL | NON_PAYE
  amountPaid     Float     @default(0)
  taxRate        Float     @default(18)
  totalHT        Float     @default(0)
  totalTTC       Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  items InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  category    String?
  unit        String  @default("pièce")
  quantity    Float
  unitPrice   Float
  total       Float
}

// ─── Factures d'achat (fournisseurs, avec pièce jointe) ─────────────────────

model Purchase {
  id         String   @id @default(cuid())
  number     String
  supplier   String
  date       DateTime @default(now())
  total      Float    @default(0)
  fileName   String?
  fileType   String?
  fileSize   Int?
  fileStored String?
  notes      String?
  createdAt  DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  quantity    Float
  unitPrice   Float
  total       Float
}

// ─── Commandes prévisionnelles ──────────────────────────────────────────────

model Order {
  id           String    @id @default(cuid())
  number       String    @unique
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName   String    @default("")
  date         DateTime  @default(now())
  deliveryDate DateTime?
  status       String    @default("EN_COURS") // EN_COURS | CONFIRMEE | LIVREE | ANNULEE
  notes        String?
  createdAt    DateTime  @default(now())

  items OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  category    String?
  unit        String  @default("pièce")
  quantity    Float
  unitPrice   Float
  total       Float
}

// ─── Immobilier (locataires & loyers) ───────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  building    String // Immeuble (ex : Immeuble F)
  unit        String? // Logement / local occupé
  monthlyRent Float    @default(0) // Loyer mensuel
  notes       String?
  createdAt   DateTime @default(now())

  rents Rent[]
}

model Rent {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month    String // AAAA-MM (ex : 2026-07)
  amount   Float     @default(0)
  status   String    @default("NON_PAYE") // PAYE | NON_PAYE
  paidAt   DateTime?
  notes    String?
  createdAt DateTime @default(now())

  @@unique([tenantId, month])
}
